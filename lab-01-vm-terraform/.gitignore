# Terraform state (contains sensitive data — never commit)
*.tfstate
*.tfstate.*
*.tfstate.backup

# Terraform working directory
.terraform/

# Plan files (may contain secrets)
*.tfplan
tfplan

# Variable files with real values (only .example files are committed)
*.tfvars
!*.tfvars.example

# Crash logs
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Credentials and env files
.env
*.env
